#!/usr/bin/env python3
"""
Mimir Enrich - Simple CLI for Context Enrichment

Usage:
    # Enrich a task and save to prompt file
    mimir-enrich "implement feature X"
    
    # Then start Jcode - context will be auto-loaded
    jcode
"""

import sys
from pathlib import Path

# Add Mimir to path
MIMIR_ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(MIMIR_ROOT / "src"))

try:
    from mimir.query_router import route_task
    from mimir.config import get_config
except ImportError as e:
    print(f"❌ Failed to import Mimir: {e}", file=sys.stderr)
    print(f"   Make sure you're in the Mimir directory", file=sys.stderr)
    sys.exit(1)


def main():
    import argparse
    
    parser = argparse.ArgumentParser(
        description="Mimir Context Enrichment - Automatic context injection for Jcode",
        epilog="""
Example:
  mimir-enrich "implement a new feature"
  jcode  # Start Jcode - context is auto-loaded
        """
    )
    parser.add_argument("task", help="Task description to enrich")
    parser.add_argument(
        "--project-root",
        type=Path,
        default=Path.cwd(),
        help="Project root (default: current directory)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        help="Output path (default: .jcode/prompts/01-mimir-enriched.md)",
    )
    
    args = parser.parse_args()
    
    # Check if Mimir project
    if not (args.project_root / ".knowledge" / "llamaindex").exists():
        print(f"❌ Not a Mimir project: {args.project_root}")
        print(f"   Run: python {MIMIR_ROOT}/mimir.py init --code-dirs=src")
        sys.exit(1)
    
    # Enrich task
    print(f"🔍 Enriching task: {args.task[:50]}...")
    
    try:
        result = route_task(args.task, project_root=args.project_root)
        
        if not result.success:
            print(f"⚠️  Enrichment failed or no context available")
        else:
            context = result.context
            print(f"✅ Enrichment successful")
            print(f"   Routed to: {result.routed_to}")
            print(f"   Context length: {len(context)} chars")
            
            # Save to prompt file
            if args.output:
                output_path = args.output
            else:
                prompts_dir = args.project_root / ".jcode" / "prompts"
                prompts_dir.mkdir(parents=True, exist_ok=True)
                output_path = prompts_dir / "01-mimir-enriched.md"
            
            # Format as prompt
            prompt_content = f"""## Mimir Auto-Enriched Context

**Task**: {args.task}
**Source**: Mimir ({result.routed_to}, {result.query_type})
**Cache**: {"hit" if result.cache_hit else "miss"}

### Project Context

{context}

---

**Instructions**: The above context was automatically injected by Mimir. Use it to inform your implementation.
"""
            
            output_path.write_text(prompt_content)
            print(f"\n✅ Context saved to: {output_path}")
            print(f"\n🚀 Now start Jcode - the context will be loaded automatically!")
            print(f"   jcode")
            
    except Exception as e:
        print(f"❌ Enrichment failed: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
