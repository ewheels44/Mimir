#!/bin/bash
# Mimir post-commit hook — auto-reindexes the knowledge base
# when documentation files change in a commit.

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
MIMIR_CLI="$(command -v mimir 2>/dev/null || echo '')"

# Only reindex if docs/ files were touched in this commit
DOCS_CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -c "^docs/" || true)
if [ "$DOCS_CHANGED" -eq 0 ]; then
    exit 0
fi

echo "📚 Mimir: changes detected — reindexing..."
cd "${PROJECT_ROOT}"
mimir index 2>&1 | tail -5
